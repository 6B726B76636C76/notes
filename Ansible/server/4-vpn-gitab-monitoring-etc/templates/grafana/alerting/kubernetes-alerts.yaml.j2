apiVersion: 1

groups:

  - orgId: 1
    name: kubernetes-alerts
    folder: "{{ grafana_alerting_folder }}"
    interval: "{{ grafana_alerting_interval }}"

    rules:

      # ========================================================
      # Node not Ready
      # ========================================================

      - uid: k8s_node_not_ready
        title: Kubernetes node is not Ready
        condition: B

        data:

          - refId: A
            queryType: ""
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: "{{ grafana_alerting_prometheus_datasource_uid }}"

            model:
              editorMode: code
              expr: |
                kube_node_status_condition{
                  condition="Ready",
                  status="true"
                }
              intervalMs: 1000
              maxDataPoints: 43200
              range: true
              refId: A

          - refId: B
            queryType: ""
            relativeTimeRange:
              from: 0
              to: 0
            datasourceUid: "-100"

            model:
              conditions:
                - evaluator:
                    params:
                      - 1
                    type: lt
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    params: []
                    type: last
                  type: query

              datasource:
                type: __expr__
                uid: "-100"

              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
              type: classic_conditions

        noDataState: Alerting
        execErrState: Alerting
        for: 5m

        labels:
          severity: critical
          component: kubernetes

        annotations:
          summary: "Kubernetes node is not Ready"
          description: "A Kubernetes node has not been Ready for 5 minutes."

      # ========================================================
      # CrashLoopBackOff
      # ========================================================

      - uid: k8s_pod_crashloop
        title: Kubernetes pod CrashLoopBackOff
        condition: B

        data:

          - refId: A
            queryType: ""
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: "{{ grafana_alerting_prometheus_datasource_uid }}"

            model:
              editorMode: code
              expr: |
                max by (namespace, pod) (
                  kube_pod_container_status_waiting_reason{
                    reason="CrashLoopBackOff"
                  }
                )
              intervalMs: 1000
              maxDataPoints: 43200
              range: true
              refId: A

          - refId: B
            queryType: ""
            relativeTimeRange:
              from: 0
              to: 0
            datasourceUid: "-100"

            model:
              conditions:
                - evaluator:
                    params:
                      - 0
                    type: gt
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    params: []
                    type: last
                  type: query

              datasource:
                type: __expr__
                uid: "-100"

              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
              type: classic_conditions

        noDataState: OK
        execErrState: Alerting
        for: 5m

        labels:
          severity: critical
          component: kubernetes

        annotations:
          summary: "Kubernetes pod is in CrashLoopBackOff"
          description: "A Kubernetes pod has remained in CrashLoopBackOff for 5 minutes."

      # ========================================================
      # Cilium
      # ========================================================

      - uid: cilium_unavailable
        title: Cilium agents unavailable
        condition: B

        data:

          - refId: A
            queryType: ""
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: "{{ grafana_alerting_prometheus_datasource_uid }}"

            model:
              editorMode: code
              expr: |
                kube_daemonset_status_desired_number_scheduled{
                  namespace="kube-system",
                  daemonset="cilium"
                }
                -
                kube_daemonset_status_number_available{
                  namespace="kube-system",
                  daemonset="cilium"
                }
              intervalMs: 1000
              maxDataPoints: 43200
              range: true
              refId: A

          - refId: B
            queryType: ""
            relativeTimeRange:
              from: 0
              to: 0
            datasourceUid: "-100"

            model:
              conditions:
                - evaluator:
                    params:
                      - 0
                    type: gt
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    params: []
                    type: last
                  type: query

              datasource:
                type: __expr__
                uid: "-100"

              expression: A
              intervalMs: 1000
              maxDataPoints: 43200
              refId: B
              type: classic_conditions

        noDataState: OK
        execErrState: Alerting
        for: 5m

        labels:
          severity: critical
          component: cilium

        annotations:
          summary: "Cilium agents are unavailable"
          description: "One or more Cilium agents are unavailable."